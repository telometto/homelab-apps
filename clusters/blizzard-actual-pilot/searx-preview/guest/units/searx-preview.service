[Unit]
Description=Private SearxNG migration preview
Requires=run-searx\x2dpreview\x2dconfig.mount searx-preview-cache.service
After=run-searx\x2dpreview\x2dconfig.mount searx-preview-cache.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
ExecStartPre=/usr/bin/python3 /usr/local/lib/searx-preview/runner.py prepare
ExecStartPre=/usr/bin/python3 /usr/local/lib/searx-preview/runner.py wait-cache
ExecStart=/usr/bin/python3 /usr/local/lib/searx-preview/runner.py run
ExecStop=-/usr/bin/podman stop --time 30 searx-preview
Restart=on-failure
RestartSec=10
TimeoutStartSec=360
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
